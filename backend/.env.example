# Cadena de conexión de PostgreSQL (Supabase: Project Settings → Database → Connection string → URI).
# Se recomienda el "Session pooler" porque la conexión directa de Supabase solo funciona por IPv6.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require"

# Puerto del servidor (opcional, por defecto 3000).
PORT=3000
