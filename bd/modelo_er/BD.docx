Success. No rows returned
-- ============================================================
-- SISTEMA DE GESTION ACADEMICA
-- INSTITUTO DE CIENCIAS BASICAS E INGENIERIA (ICBI) - UAEH
-- Motor: PostgreSQL / Supabase
-- ============================================================

-- ============================================================
-- 1. TABLA: DOCENTE
-- ============================================================

CREATE TABLE IF NOT EXISTS docente (
    num_cuenta VARCHAR(20) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellidos VARCHAR(150) NOT NULL,
    direccion TEXT,
    sindicalizado BOOLEAN NOT NULL DEFAULT FALSE,
    correo_personal VARCHAR(150) UNIQUE,
    correo_institucional VARCHAR(150) UNIQUE,
    telefono VARCHAR(20),
    nss VARCHAR(20) UNIQUE,
    curp VARCHAR(18) UNIQUE,

    CONSTRAINT chk_docente_curp
        CHECK (curp IS NULL OR char_length(curp) = 18)
);


-- ============================================================
-- 2. TABLA: ALUMNO
-- ============================================================

CREATE TABLE IF NOT EXISTS alumno (
    num_cuenta VARCHAR(20) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellidos VARCHAR(150) NOT NULL,
    direccion TEXT,
    telefono VARCHAR(20),
    correo_personal VARCHAR(150) UNIQUE,
    correo_institucional VARCHAR(150) UNIQUE,
    nss VARCHAR(20) UNIQUE,
    curp VARCHAR(18) UNIQUE,

    CONSTRAINT chk_alumno_curp
        CHECK (curp IS NULL OR char_length(curp) = 18)
);


-- ============================================================
-- 3. TABLA: ASIGNATURA
-- ============================================================

CREATE TABLE IF NOT EXISTS asignatura (
    codigo VARCHAR(20) PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    creditos SMALLINT NOT NULL,
    horas_semanales SMALLINT NOT NULL,

    CONSTRAINT chk_asignatura_creditos
        CHECK (creditos > 0),

    CONSTRAINT chk_asignatura_horas
        CHECK (horas_semanales > 0)
);


-- ============================================================
-- 4. TABLA: PROGRAMA ACADEMICO
-- ============================================================

CREATE TABLE IF NOT EXISTS programa_academico (
    id_programa BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL UNIQUE,
    descripcion TEXT
);


-- ============================================================
-- 5. TABLA INTERMEDIA: PROGRAMA_ASIGNATURA
-- Resuelve la relacion M:N entre programas y asignaturas.
-- ============================================================

CREATE TABLE IF NOT EXISTS programa_asignatura (
    id_programa BIGINT NOT NULL,
    codigo_asignatura VARCHAR(20) NOT NULL,

    PRIMARY KEY (id_programa, codigo_asignatura),

    CONSTRAINT fk_pa_programa
        FOREIGN KEY (id_programa)
        REFERENCES programa_academico(id_programa)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_pa_asignatura
        FOREIGN KEY (codigo_asignatura)
        REFERENCES asignatura(codigo)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);


-- ============================================================
-- 6. TABLA: PERIODO ACADEMICO
-- ============================================================

CREATE TABLE IF NOT EXISTS periodo_academico (
    id_periodo BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    anio SMALLINT NOT NULL,
    semestre SMALLINT NOT NULL,
    fecha_inicio DATE NOT NULL,
    fecha_fin DATE NOT NULL,

    CONSTRAINT uq_periodo
        UNIQUE (anio, semestre),

    CONSTRAINT chk_periodo_semestre
        CHECK (semestre IN (1, 2)),

    CONSTRAINT chk_periodo_fechas
        CHECK (fecha_fin > fecha_inicio)
);


-- ============================================================
-- 7. TABLA: GRUPO
-- Cada grupo tiene un docente, asignatura, programa y periodo.
-- ============================================================

CREATE TABLE IF NOT EXISTS grupo (
    id_grupo BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    clave_grupo VARCHAR(30) NOT NULL,

    num_cuenta_docente VARCHAR(20) NOT NULL,
    codigo_asignatura VARCHAR(20) NOT NULL,
    id_programa BIGINT NOT NULL,
    id_periodo BIGINT NOT NULL,

    CONSTRAINT uq_grupo_periodo
        UNIQUE (clave_grupo, id_periodo),

    -- Un grupo debe pertenecer a un programa
    -- que realmente incluya la asignatura.

    CONSTRAINT fk_grupo_programa_asignatura
        FOREIGN KEY (id_programa, codigo_asignatura)
        REFERENCES programa_asignatura(id_programa, codigo_asignatura)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_grupo_docente
        FOREIGN KEY (num_cuenta_docente)
        REFERENCES docente(num_cuenta)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_grupo_periodo
        FOREIGN KEY (id_periodo)
        REFERENCES periodo_academico(id_periodo)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);


-- ============================================================
-- 8. TABLA: INSCRIPCION
-- Resuelve la relacion M:N entre alumnos y grupos.
-- Tambien almacena la calificacion final.
-- ============================================================

CREATE TABLE IF NOT EXISTS inscripcion (
    id_inscripcion BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

    num_cuenta_alumno VARCHAR(20) NOT NULL,
    id_grupo BIGINT NOT NULL,

    calificacion_final NUMERIC(4,2),

    CONSTRAINT uq_alumno_grupo
        UNIQUE (num_cuenta_alumno, id_grupo),

    CONSTRAINT chk_calificacion
        CHECK (
            calificacion_final IS NULL
            OR calificacion_final BETWEEN 0 AND 10
        ),

    CONSTRAINT fk_inscripcion_alumno
        FOREIGN KEY (num_cuenta_alumno)
        REFERENCES alumno(num_cuenta)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT fk_inscripcion_grupo
        FOREIGN KEY (id_grupo)
        REFERENCES grupo(id_grupo)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);


-- ============================================================
-- 9. INDICES PARA OPTIMIZAR CONSULTAS
-- ============================================================

CREATE INDEX IF NOT EXISTS idx_grupo_docente
    ON grupo(num_cuenta_docente);

CREATE INDEX IF NOT EXISTS idx_grupo_asignatura
    ON grupo(codigo_asignatura);

CREATE INDEX IF NOT EXISTS idx_grupo_programa
    ON grupo(id_programa);

CREATE INDEX IF NOT EXISTS idx_grupo_periodo_id
    ON grupo(id_periodo);

CREATE INDEX IF NOT EXISTS idx_inscripcion_alumno
    ON inscripcion(num_cuenta_alumno);

CREATE INDEX IF NOT EXISTS idx_inscripcion_grupo
    ON inscripcion(id_grupo);


-- ============================================================
-- 10. FUNCION: VALIDAR INSCRIPCIONES
--
-- Reglas:
-- A) Maximo 8 asignaturas por alumno en cada periodo.
-- B) No cursar dos veces la misma asignatura en el mismo periodo.
-- ============================================================

CREATE OR REPLACE FUNCTION validar_inscripcion()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_periodo BIGINT;
    v_asignatura VARCHAR(20);
    v_total INTEGER;
    v_duplicada BOOLEAN;
BEGIN

    -- Obtener periodo y asignatura del grupo seleccionado.

    SELECT id_periodo, codigo_asignatura
    INTO v_periodo, v_asignatura
    FROM grupo
    WHERE id_grupo = NEW.id_grupo;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'El grupo seleccionado no existe.';
    END IF;


    -- Bloquear temporalmente las operaciones concurrentes
    -- del mismo alumno y periodo.

    PERFORM pg_advisory_xact_lock(
        hashtextextended(
            NEW.num_cuenta_alumno || ':' || v_periodo::TEXT,
            0
        )
    );


    -- Contar asignaturas inscritas en el mismo periodo.
    -- Se excluye el registro actual cuando se trata de UPDATE.

    SELECT COUNT(*)
    INTO v_total
    FROM inscripcion i
    INNER JOIN grupo g
        ON g.id_grupo = i.id_grupo
    WHERE i.num_cuenta_alumno = NEW.num_cuenta_alumno
      AND g.id_periodo = v_periodo
      AND i.id_inscripcion IS DISTINCT FROM NEW.id_inscripcion;


    IF v_total >= 8 THEN
        RAISE EXCEPTION
            'El alumno ya tiene el maximo de 8 asignaturas en este periodo.';
    END IF;


    -- Comprobar que no exista la misma asignatura
    -- en otro grupo del mismo periodo.

    SELECT EXISTS (
        SELECT 1
        FROM inscripcion i
        INNER JOIN grupo g
            ON g.id_grupo = i.id_grupo
        WHERE i.num_cuenta_alumno = NEW.num_cuenta_alumno
          AND g.id_periodo = v_periodo
          AND g.codigo_asignatura = v_asignatura
          AND i.id_inscripcion IS DISTINCT FROM NEW.id_inscripcion
    )
    INTO v_duplicada;


    IF v_duplicada THEN
        RAISE EXCEPTION
            'El alumno ya esta inscrito en esta asignatura durante el mismo periodo.';
    END IF;


    RETURN NEW;

END;
$$;


-- ============================================================
-- 11. TRIGGER: VALIDAR INSCRIPCIONES
-- ============================================================

DROP TRIGGER IF EXISTS trg_validar_inscripcion
ON inscripcion;

CREATE TRIGGER trg_validar_inscripcion
BEFORE INSERT OR UPDATE
ON inscripcion
FOR EACH ROW
EXECUTE FUNCTION validar_inscripcion();


-- ============================================================
-- 12. VISTA: REPORTE SEMESTRAL DE CALIFICACIONES
--
-- Incluye datos del alumno, docente, asignatura, grupo,
-- programa, periodo y promedio grupal.
-- ============================================================

CREATE OR REPLACE VIEW v_reporte_calificaciones AS

SELECT
    i.id_inscripcion,

    pa.anio,
    pa.semestre,

    g.id_grupo,
    g.clave_grupo,

    pr.id_programa,
    pr.nombre AS programa_academico,

    a.codigo AS codigo_asignatura,
    a.nombre AS asignatura,
    a.creditos,
    a.horas_semanales,

    d.num_cuenta AS cuenta_docente,
    d.nombre || ' ' || d.apellidos AS docente,

    al.num_cuenta AS cuenta_alumno,
    al.nombre || ' ' || al.apellidos AS alumno,

    i.calificacion_final,

    AVG(i.calificacion_final)
        OVER (PARTITION BY g.id_grupo)
        AS promedio_grupal

FROM inscripcion i

INNER JOIN alumno al
    ON al.num_cuenta = i.num_cuenta_alumno

INNER JOIN grupo g
    ON g.id_grupo = i.id_grupo

INNER JOIN docente d
    ON d.num_cuenta = g.num_cuenta_docente

INNER JOIN asignatura a
    ON a.codigo = g.codigo_asignatura

INNER JOIN programa_academico pr
    ON pr.id_programa = g.id_programa

INNER JOIN periodo_academico pa
    ON pa.id_periodo = g.id_periodo;


-- ============================================================
-- FIN DEL SCRIPT
-- ============================================================

